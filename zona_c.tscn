; =========================================================
; MATERIALES (Paleta oficial CustomVeloz)
; =========================================================

; --- Suelo: Gris Asfalto #263238 ---
[sub_resource type="StandardMaterial3D" id="PisoMat"]
albedo_color = Color(0.149, 0.196, 0.22, 1)

; --- Rampa: gris ligeramente diferenciado con textura clara ---
[sub_resource type="StandardMaterial3D" id="RampaMat"]
albedo_color = Color(0.18, 0.23, 0.26, 1)

; --- Bordes: Azul Neón #00E5FF con emisión brillante ---
[sub_resource type="StandardMaterial3D" id="BordeMat"]
albedo_color = Color(0, 0.898, 1, 1)
emission_enabled = true
emission = Color(0, 0.898, 1, 1)
emission_energy_multiplier = 1.5

; --- Esferas Verdes: #76FF03 evolución +15 km/h ---
[sub_resource type="StandardMaterial3D" id="EsferaMat"]
albedo_color = Color(0.4627451, 1, 0.011764706, 1)
emission_enabled = true
emission = Color(0.4627451, 1, 0.011764706, 1)

; --- Esferas Amarillas: #FFEA00 onda expansiva (shockwave) ---
[sub_resource type="StandardMaterial3D" id="EsferaAtaqueMat"]
albedo_color = Color(1, 0.91764706, 0, 1)
emission_enabled = true
emission = Color(1, 0.91764706, 0, 1)

; --- Conos Obstáculo: Naranja Fuego #FF5722 ---
[sub_resource type="StandardMaterial3D" id="ConoMat"]
albedo_color = Color(1, 0.341, 0.133, 1)
emission_enabled = true
emission = Color(1, 0.341, 0.133, 1)
emission_energy_multiplier = 0.4

; --- Esfera Brillo decorativa ---
[sub_resource type="StandardMaterial3D" id="BrilloMat"]
albedo_color = Color(0.690196, 0.745098, 0.772549, 1)
roughness = 0.2

